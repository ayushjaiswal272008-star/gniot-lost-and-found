# GEMINI_API_KEY: Required for Gemini AI API calls on the Express backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Enables direct database persistence for reports, claims, notifications, and locations on GitHub Pages.
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Your Supabase public anonymous API key (from Project Settings -> API)
VITE_SUPABASE_ANON_KEY=""

# VITE_BACKEND_URL: Optional separately hosted Express backend server (e.g. https://gniot-lost-found-api.onrender.com)
# Needed if you host the full server.ts on Render / Railway / Cloud Run for server-side Gemini AI features.
VITE_BACKEND_URL=""
